{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haffey.example/bedrock/infrastructure-apply-manifest.schema.json",
  "title": "Infrastructure apply manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "target", "plan", "apply", "authority", "artifacts", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "source": {"$ref": "#/$defs/source"},
    "target": {"$ref": "#/$defs/target"},
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["digest", "created_at", "expires_at", "producer", "source", "target", "custody"],
      "properties": {
        "digest": {"$ref": "#/$defs/digest"}, "created_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"},
        "producer": {"type": "string", "minLength": 1}, "source": {"$ref": "#/$defs/source"}, "target": {"$ref": "#/$defs/target"},
        "custody": {"type": "object", "required": ["encrypted", "readers", "retention"], "additionalProperties": false, "properties": {"encrypted": {"const": true}, "readers": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "retention": {"type": "string", "minLength": 1}}}
      }
    },
    "apply": {"type": "object", "additionalProperties": false, "required": ["source", "target", "plan_digest", "actor", "concurrency"], "properties": {"source": {"$ref": "#/$defs/source"}, "target": {"$ref": "#/$defs/target"}, "plan_digest": {"$ref": "#/$defs/digest"}, "actor": {"type": "string", "minLength": 1}, "concurrency": {"enum": ["queue", "fail_closed"]}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["approved", "approver", "environment", "authorized_actors"], "properties": {"approved": {"const": true}, "approver": {"type": "string", "minLength": 1}, "environment": {"type": "string", "minLength": 1}, "authorized_actors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/digest"}, "uniqueItems": true},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["policy", "recovery", "retention"], "properties": {"policy": {"type": "string", "minLength": 1}, "recovery": {"type": "string", "minLength": 1}, "retention": {"type": "string", "minLength": 1}}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["commit", "configuration_digest", "lock_digest", "tool_version", "profile"], "properties": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "configuration_digest": {"$ref": "#/$defs/digest"}, "lock_digest": {"$ref": "#/$defs/digest"}, "tool_version": {"type": "string", "minLength": 1}, "profile": {"type": "string", "minLength": 1}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["environment", "account", "workspace", "state_lineage", "state_serial"], "properties": {"environment": {"type": "string", "minLength": 1}, "account": {"type": "string", "minLength": 1}, "workspace": {"type": "string", "minLength": 1}, "state_lineage": {"type": "string", "minLength": 1}, "state_serial": {"type": "integer", "minimum": 0}}}
  }
}
