{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haffey.example/bedrock/delivery-profile.schema.json",
  "title": "Application delivery profile",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "profile", "ci", "topology", "release_events", "artifact", "identity", "concurrency", "environments", "provenance", "static_frontend"],
  "properties": {
    "schema_version": {"const": 1}, "profile": {"type": "string", "minLength": 1}, "ci": {"type": "string", "minLength": 1},
    "topology": {"enum": ["main-only", "feature-to-main", "develop-to-main", "release-branch", "merge-queue"]},
    "release_events": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["merge", "squash", "queue", "batch", "revert", "direct-push", "manual"]}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["store", "promote_by_digest", "build_once"], "properties": {"store": {"type": "string", "minLength": 1}, "promote_by_digest": {"const": true}, "build_once": {"const": true}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["method", "long_lived_keys"], "properties": {"method": {"type": "string", "minLength": 1}, "long_lived_keys": {"const": false}}},
    "concurrency": {"type": "object", "additionalProperties": false, "required": ["verification", "mutation"], "properties": {"verification": {"enum": ["cancel_stale", "parallel"]}, "mutation": {"enum": ["queue", "fail_closed"]}}},
    "environments": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "desired_state_owner", "approval"], "properties": {"name": {"type": "string", "minLength": 1}, "desired_state_owner": {"enum": ["direct-deploy", "gitops", "external"]}, "approval": {"type": "string", "minLength": 1}}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["sbom", "attestation", "verification", "retention"], "properties": {"sbom": {"const": true}, "attestation": {"type": "string", "minLength": 1}, "verification": {"type": "string", "minLength": 1}, "retention": {"type": "string", "minLength": 1}}},
    "static_frontend": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["preview_trust", "source_maps", "cache_policy", "headers"],
      "properties": {
        "preview_trust": {"enum": ["trusted-isolated", "disabled"]},
        "source_maps": {"enum": ["private", "public-approved", "disabled"]},
        "cache_policy": {"type": "string", "minLength": 1},
        "headers": {"type": "array", "uniqueItems": true, "items": {"enum": ["Content-Security-Policy", "Strict-Transport-Security", "Permissions-Policy", "Referrer-Policy", "X-Content-Type-Options", "frame-ancestors"]}}
      }
    }
  }
}
