{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:haffey:bedrock:application-service-profile:1.0.0",
  "title": "Application service profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stack_profile", "capabilities", "data", "runtime", "verification"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "stack_profile": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["minimum", "persistence", "outbound", "protected", "evented", "durable-work", "high-risk"]},
      "contains": {"const": "minimum"}
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_tier", "log_ceiling"],
      "properties": {
        "maximum_tier": {"type": "integer", "minimum": 1, "maximum": 4},
        "log_ceiling": {"type": "integer", "minimum": 1, "maximum": 2}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concurrency_model", "shutdown_behavior"],
      "properties": {
        "concurrency_model": {"enum": ["sync-worker", "async-event-loop", "mixed-bounded"]},
        "shutdown_behavior": {"type": "string", "minLength": 1}
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
