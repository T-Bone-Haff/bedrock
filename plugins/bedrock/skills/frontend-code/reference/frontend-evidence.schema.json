{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bedrock.haffey.dev/schemas/frontend-evidence.schema.json",
  "title": "Bedrock frontend evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "candidate", "environments", "gates", "browser_runs", "manual_accessibility", "performance", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "build_sha256", "profile_sha256"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "build_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "os", "browser", "browser_version", "tools"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "os": {"type": "string", "minLength": 1},
          "browser": {"type": "string", "minLength": 1},
          "browser_version": {"type": "string", "minLength": 1},
          "tools": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/result"}
    },
    "browser_runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["engine", "version", "status", "scenarios", "evidence"],
        "properties": {
          "engine": {"enum": ["chromium", "firefox", "webkit", "safari", "other"]},
          "version": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "unverified", "not-applicable"]},
          "scenarios": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evidence": {"type": "string", "minLength": 1},
          "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "manual_accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "os", "os_version", "browser", "browser_version", "assistive_technology", "assistive_technology_version", "flow", "observations", "limitations", "evidence"],
      "properties": {
        "status": {"enum": ["pass", "fail", "unverified", "not-applicable"]},
        "os": {"type": "string", "minLength": 1},
        "os_version": {"type": "string", "minLength": 1},
        "browser": {"type": "string", "minLength": 1},
        "browser_version": {"type": "string", "minLength": 1},
        "assistive_technology": {"type": "string", "minLength": 1},
        "assistive_technology_version": {"type": "string", "minLength": 1},
        "flow": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "observations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "scenario", "environment", "budget_declared_before_measurement", "measurements", "evidence"],
      "properties": {
        "status": {"enum": ["pass", "fail", "unverified", "not-applicable"]},
        "scenario": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "budget_declared_before_measurement": {"const": true},
        "measurements": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence", "limitations"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "fail", "unverified", "not-applicable"]},
        "evidence": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
