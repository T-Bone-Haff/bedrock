{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bedrock.haffey.dev/schemas/execution-relay-v1.json",
  "type": "object",
  "required": ["schema_version", "profile", "repository", "base_revision", "touch", "gates", "substrate_policy"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"enum": ["small", "standard", "high-assurance"]},
    "repository": {"type": "string", "minLength": 1},
    "base_revision": {"type": "string", "minLength": 7},
    "touch": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "gates": {"type": "array", "items": {"enum": ["edit", "stage", "commit", "push", "pr", "merge", "cleanup"]}},
    "substrate_policy": {"const": "untrusted-data"},
    "authorization": {
      "type": "object",
      "required": ["actor", "scope_digest", "issued_at", "expires_at", "nonce", "revocation_check"],
      "additionalProperties": false,
      "properties": {
        "actor": {"type": "string", "minLength": 1},
        "scope_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "nonce": {"type": "string", "minLength": 16},
        "revocation_check": {"type": "string", "minLength": 1}
      }
    },
    "mutations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "operation", "before_digest", "after_digest", "file_type", "mode", "encoding"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "operation": {"enum": ["add", "modify", "delete", "rename"]},
          "before_digest": {"type": ["string", "null"]},
          "after_digest": {"type": ["string", "null"]},
          "file_type": {"enum": ["regular", "symlink"]},
          "mode": {"type": "string", "pattern": "^[0-7]{6}$"},
          "encoding": {"type": "string"},
          "symlink_target": {"type": "string"},
          "rename_from": {"type": "string"}
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"profile": {"const": "high-assurance"}}}, "then": {"required": ["authorization", "mutations"]}}
  ]
}
